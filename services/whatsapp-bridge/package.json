{
  "name": "pmpl-whatsapp-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Holds the WhatsApp connection for the Pooja Machines portal. Runs beside the Next app, not on Vercel.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "check:auth": "tsx scripts/check-auth-state.ts"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "6.7.24",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
