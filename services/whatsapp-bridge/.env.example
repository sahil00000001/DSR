# The WhatsApp bridge — copy to .env and fill in.
#
# Every value here is a credential. This file is the example; the real .env is gitignored
# and must stay that way.

# --- Required ---------------------------------------------------------------

# The same Postgres the app uses, in SESSION mode (port 5432, not the 6543 pooler).
# The bridge is a long-lived process holding its own pool, so it wants a real session;
# transaction pooling would break prepared statements under it.
# Remember to percent-encode the password: @ becomes %40.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# What the app must present on /send. Generate a fresh one, do not reuse another secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# This token is the only thing standing between the internet and your WhatsApp account.
BRIDGE_TOKEN=""

# --- Inbound replies (needed for the STATUS command) ------------------------

# The app's webhook. Must be the deployed URL, not localhost.
APP_WEBHOOK_URL="https://your-app.vercel.app/api/whatsapp"

# Shared secret this bridge signs forwarded messages with. Must match BAILEYS_WEBHOOK_SECRET
# in the app's environment, and must be different from BRIDGE_TOKEN — they protect
# opposite directions, and one leaking should not compromise the other.
BRIDGE_WEBHOOK_SECRET=""

# --- Recommended ------------------------------------------------------------

# Only this number is forwarded to the app. Digits with country code, no plus.
# Leave empty and every stranger who messages the number gets the order book read to them.
ADMIN_NUMBER="919876543210"

# --- Optional ---------------------------------------------------------------

# Lets a second number be paired later without a schema change.
SESSION_ID="default"

PORT="8080"
LOG_LEVEL="info"
