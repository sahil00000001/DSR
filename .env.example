#===============================================================================
# Pooja Machines portal — environment configuration
# Copy to `.env` for local development. In production set these in Vercel.
#===============================================================================

#-------------------------------------------------------------------------------
# Database (required) — PostgreSQL
#-------------------------------------------------------------------------------
# BOTH are required. DIRECT_URL is not optional in practice: prisma/schema.prisma
# references it as `directUrl`, and Prisma errors when a referenced datasource
# variable is missing — including during the Vercel build's `prisma generate`.
#
# With Supabase, take BOTH from Connect → "Connection pooling". The pooler serves
# two modes on two ports from the SAME host:
#
#   6543  transaction mode (pgbouncer)  → DATABASE_URL, the app at runtime.
#         Serverless opens a connection per invocation; a direct connection limit
#         is exhausted almost immediately, and the symptom is random 500s.
#
#   5432  session mode                  → DIRECT_URL, migrations and DDL.
#         Transaction mode can't hold the session state Prisma's DDL needs.
#
# Don't use db.<ref>.supabase.co — newer projects don't publish it, or publish it
# IPv6-only. The pooler on port 5432 replaces it.
#
# Percent-encode special characters in the password:
#   @ → %40   # → %23   : → %3A   / → %2F   ? → %3F   & → %26
DATABASE_URL="postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres"
#
# For offline local development you can instead switch `provider` in
# prisma/schema.prisma to "sqlite" and use:
# DATABASE_URL="file:./dev.db"

#-------------------------------------------------------------------------------
# Supabase project (optional)
#-------------------------------------------------------------------------------
# This app uses Prisma against Postgres and owns its own sessions, so these are
# not needed to run. They're read for future Storage / Realtime use.
# SUPABASE_SECRET_KEY bypasses row-level security — server-side only, never
# expose it with a NEXT_PUBLIC_ prefix.
#
# Leave these commented out if unused. (A blank value is tolerated too, but
# omitting them entirely is clearer.)
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_PUBLISHABLE_KEY=""
# SUPABASE_SECRET_KEY=""
# SUPABASE_JWKS_URL="https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json"

#-------------------------------------------------------------------------------
# Auth (required)
#-------------------------------------------------------------------------------
# Signing key for session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# Canonical origin of the deployment. Used for links in emails + OAuth redirects.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Shows the seeded demo credentials on the sign-in screen.
# Set to "false" for any real installation.
NEXT_PUBLIC_DEMO_MODE="true"

#-------------------------------------------------------------------------------
# Google OAuth (optional — "Continue with Google" is hidden when unset)
#-------------------------------------------------------------------------------
# Console: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Comma separated list of email domains allowed to sign in with Google.
# Empty = any Google account that already exists as an employee.
GOOGLE_ALLOWED_DOMAINS=""

#-------------------------------------------------------------------------------
# Email / SMTP (optional — emails are logged to the console when unset)
#-------------------------------------------------------------------------------
# Gmail: enable 2FA, then create an App Password at
# https://myaccount.google.com/apppasswords  (enter it without spaces).
# Gmail rejects a From address that isn't the authenticated account, so
# EMAIL_FROM must use SMTP_USER's mailbox.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Pooja Machines <no-reply@poojamachines.co.in>"

#-------------------------------------------------------------------------------
# Scheduled jobs (Vercel Cron)
#-------------------------------------------------------------------------------
# Shared secret required by /api/cron/* — sent as `Authorization: Bearer <secret>`
CRON_SECRET=""

# ---------------------------------------------------------------------------
# WhatsApp order summaries — see docs/WHATSAPP.md
# ---------------------------------------------------------------------------
# cloud    = Meta official (recommended: no server, no ban risk, ~Rs 0-4/month)
# baileys  = self-hosted bridge (free, unofficial; needs an always-on box; ban risk)
# openwa   = older self-hosted gateway (same constraints, much heavier)
# telegram = free forever, no approval
# none     = log only (the default)
MESSAGING_PROVIDER="none"
# Country code, digits only, no plus.
MESSAGING_ADMIN_NUMBER=""

# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_SUMMARY_TEMPLATE="order_daily_summary"

# Self-hosted Baileys bridge (cannot run on Vercel — see services/whatsapp-bridge)
# The token and the secret must match the bridge's own environment. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BAILEYS_BRIDGE_URL=""
BAILEYS_BRIDGE_TOKEN=""
BAILEYS_WEBHOOK_SECRET=""

# Self-hosted OpenWA gateway (cannot run on Vercel)
OPENWA_BASE_URL=""
OPENWA_API_KEY=""
OPENWA_SESSION_ID=""
OPENWA_WEBHOOK_SECRET=""

# Telegram
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
