// ============================================================================
//  Cadence — Prisma schema
// ============================================================================
//  PORTABILITY NOTE
//  ----------------
//  This schema deliberately avoids native database enums and JSON columns and
//  uses `String` + application-level unions (see src/lib/constants/enums.ts)
//  instead. Every such column is validated by Zod at each write boundary, so the
//  guarantee a DB enum would give you is preserved — in the layer where the error
//  message is actually useful to the person filling in the form.
//
//  The practical benefit: the schema runs unchanged on PostgreSQL (Supabase, in
//  production) and on SQLite (`provider = "sqlite"`, `DATABASE_URL="file:./dev.db"`)
//  for offline development, with no migration rewrite and no `@db.*` annotations
//  to untangle.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Prisma 7 removed `url` / `directUrl` from the schema. Connection strings for
  // the CLI (migrate, db push, studio) now live in `prisma.config.ts`, and the
  // runtime client takes a driver adapter instead — see src/lib/db/prisma.ts.
  //
  // The practical upshot is a real improvement: pooling is handled by `pg`, which
  // we configure directly, and the Rust query engine binary is gone from the
  // deployment bundle.
}

// ---------------------------------------------------------------------------
//  Organisation structure
// ---------------------------------------------------------------------------

model Department {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  /// Design-system colour token, e.g. "indigo" | "emerald" — drives chart + badge colours.
  color       String  @default("indigo")

  headId String?
  head   User?   @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)

  teams         Team[]
  members       User[]         @relation("UserDepartment")
  announcements Announcement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([headId])
}

model Team {
  id   String @id @default(cuid())
  name String
  slug String @unique

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  members User[] @relation("UserTeam")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
}

model Location {
  id       String @id @default(cuid())
  name     String
  code     String @unique
  city     String
  country  String
  timezone String @default("Asia/Kolkata")

  members  User[]    @relation("UserLocation")
  holidays Holiday[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
//  People & identity
// ---------------------------------------------------------------------------

model User {
  id           String  @id @default(cuid())
  /// Human-facing employee identifier, e.g. "CAD-014".
  employeeCode String  @unique
  name         String
  email        String  @unique
  /// Null for accounts that authenticate exclusively through Google OAuth.
  passwordHash String?
  phone        String?
  avatarUrl    String?
  designation  String?
  bio          String?

  /// Role — one of ADMIN | MANAGER | EMPLOYEE (see enums.ts).
  role String @default("EMPLOYEE")
  /// Status — one of ACTIVE | DISABLED | INVITED.
  status String @default("ACTIVE")

  departmentId String?
  department   Department? @relation("UserDepartment", fields: [departmentId], references: [id], onDelete: SetNull)

  teamId String?
  team   Team?   @relation("UserTeam", fields: [teamId], references: [id], onDelete: SetNull)

  locationId String?
  location   Location? @relation("UserLocation", fields: [locationId], references: [id], onDelete: SetNull)

  managerId String?
  manager   User?   @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports   User[]  @relation("UserManager")

  joinedAt        DateTime  @default(now())
  dateOfBirth     DateTime?
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  // Preferences
  theme               String  @default("system")
  notifyByEmail       Boolean @default(true)
  dsrReminderOptOut   Boolean @default(false)

  // Relations
  headedDepartments Department[]        @relation("DepartmentHead")
  reports_dsr       DailyStatusReport[] @relation("DsrAuthor")
  reviewedDsrs      DailyStatusReport[] @relation("DsrReviewer")
  attendance        Attendance[]
  leaveRequests     LeaveRequest[]      @relation("LeaveRequester")
  leaveDecisions    LeaveRequest[]      @relation("LeaveDecider")
  leaveBalances     LeaveBalance[]
  notifications     Notification[]      @relation("NotificationRecipient")
  triggered         Notification[]      @relation("NotificationActor")
  announcements     Announcement[]
  auditLogs         AuditLog[]
  sessions          Session[]
  uploads           Attachment[]
  expenseClaims     ExpenseClaim[]     @relation("ExpenseClaimant")
  expenseDecisions  ExpenseClaim[]     @relation("ExpenseDecider")
  expenseComments   ExpenseComment[]
  tasksCreated      Task[]              @relation("TaskCreator")
  taskAssignments   TaskAssignee[]      @relation("TaskAssignee")
  taskAssignmentsMade TaskAssignee[]    @relation("TaskAssigner")
  taskUpdates       TaskUpdate[]        @relation("TaskUpdateAuthor")
  taskMentions      TaskMention[]       @relation("TaskMentioned")
  taskActivities    TaskActivity[]      @relation("TaskActivityActor")
  checklistDone     TaskChecklistItem[] @relation("ChecklistCompleter")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
  @@index([departmentId])
  @@index([teamId])
  @@index([locationId])
  @@index([managerId])
}

/// Server-side session registry. The session cookie is a signed JWT whose `jti`
/// points at a row here, which is what makes revocation ("sign out everywhere",
/// disabling an employee) take effect immediately.
model Session {
  id        String   @id @default(cuid())
  tokenId   String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
  @@index([expiresAt])
}

/// Single-use tokens for password reset, e-mail verification and invitations.
/// Only a SHA-256 hash of the token is stored.
model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  tokenHash  String   @unique
  /// PASSWORD_RESET | EMAIL_VERIFY | INVITE
  type       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([identifier, type])
}

// ---------------------------------------------------------------------------
//  Daily Status Reports
// ---------------------------------------------------------------------------

model DailyStatusReport {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("DsrAuthor", fields: [userId], references: [id], onDelete: Cascade)

  /// Normalised to UTC midnight of the reporting day.
  date DateTime

  /// Markdown. Rendered by a sanitising renderer — never with dangerouslySetInnerHTML on raw input.
  tasksCompleted String
  blockers       String?
  nextSteps      String?
  notes          String?
  hoursWorked    Float   @default(0)

  /// DRAFT | SUBMITTED | REVIEWED | FLAGGED
  status      String    @default("DRAFT")
  submittedAt DateTime?

  reviewedById  String?
  reviewedBy    User?     @relation("DsrReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  reviewComment String?

  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([status])
  @@index([userId, status])
  @@index([reviewedById])
}

// ---------------------------------------------------------------------------
//  Attendance
// ---------------------------------------------------------------------------

model Attendance {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Normalised to UTC midnight.
  date DateTime

  /// PRESENT | ABSENT | LEAVE | HALF_DAY | WFH | HOLIDAY | WEEKEND
  status        String
  checkInAt     DateTime?
  checkOutAt    DateTime?
  workedMinutes Int       @default(0)
  note          String?
  /// SELF | ADMIN | SYSTEM
  source        String    @default("SELF")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([date])
  @@index([status])
  @@index([userId, date])
}

// ---------------------------------------------------------------------------
//  Leave
// ---------------------------------------------------------------------------

model LeaveRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)

  /// CASUAL | SICK | EARNED | UNPAID
  type      String
  startDate DateTime
  endDate   DateTime
  /// Working days consumed — supports halves (0.5).
  days      Float
  halfDay   Boolean  @default(false)
  reason    String

  /// PENDING | APPROVED | REJECTED | CANCELLED
  status String @default("PENDING")

  decidedById  String?
  decidedBy    User?     @relation("LeaveDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?

  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([startDate])
  @@index([userId, status])
}

model LeaveBalance {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  year Int
  /// CASUAL | SICK | EARNED
  type String

  allocated Float @default(5)
  used      Float @default(0)
  /// Days locked by requests awaiting a decision.
  pending   Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, year, type])
  @@index([userId, year])
}

// ---------------------------------------------------------------------------
//  Communication
// ---------------------------------------------------------------------------

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  /// See NOTIFICATION_TYPES in enums.ts
  type   String
  title  String
  body   String?
  href   String?
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}

model Announcement {
  id       String @id @default(cuid())
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  title  String
  body   String
  pinned Boolean @default(false)

  /// ALL | DEPARTMENT
  audience     String  @default("ALL")
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publishedAt])
  @@index([authorId])
}

model Holiday {
  id   String   @id @default(cuid())
  name String
  date DateTime
  /// PUBLIC | OPTIONAL | COMPANY
  type String   @default("PUBLIC")

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([date])
}

// ---------------------------------------------------------------------------
//  Files & audit
// ---------------------------------------------------------------------------

model Attachment {
  id       String @id @default(cuid())
  filename String
  url      String
  mimeType String
  size     Int

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  dsrId String?
  dsr   DailyStatusReport? @relation(fields: [dsrId], references: [id], onDelete: Cascade)

  leaveRequestId String?
  leaveRequest   LeaveRequest? @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  expenseClaimId String?
  expenseClaim   ExpenseClaim? @relation(fields: [expenseClaimId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  taskUpdateId String?
  taskUpdate   TaskUpdate? @relation(fields: [taskUpdateId], references: [id], onDelete: Cascade)

  /// Storage object path within the private bucket. Signed on demand for viewing;
  /// never a public URL.
  storagePath String?

  createdAt DateTime @default(now())

  @@index([dsrId])
  @@index([leaveRequestId])
  @@index([expenseClaimId])
  @@index([taskId])
  @@index([taskUpdateId])
}

model AuditLog {
  id      String  @id @default(cuid())
  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  /// e.g. "leave.approve", "employee.update", "auth.login"
  action   String
  entity   String
  entityId String?
  /// JSON-encoded payload (kept as text for provider portability).
  meta     String?
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([entity, entityId])
}

// ---------------------------------------------------------------------------
//  Expense claims
// ---------------------------------------------------------------------------

/// An expense an employee paid for and wants reimbursed.
///
/// Status flow: DRAFT → SUBMITTED → APPROVED → REIMBURSED
///                              ↘ REJECTED
///              (CANCELLED from DRAFT or SUBMITTED, by the claimant)
///
/// Amounts are stored in paise/cents as an Int, never as a Float. A Float cannot
/// represent 1234.55 exactly, and money that fails to sum correctly is worse than
/// no feature at all. Formatting back to rupees happens at the display boundary.
model ExpenseClaim {
  id String @id @default(cuid())

  /// Human reference shown to people and quoted in emails, e.g. "EXP-0042".
  claimNumber String @unique

  userId String
  user   User   @relation("ExpenseClaimant", fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String

  /// TRAVEL | FUEL | FREIGHT | TOOLS | MATERIALS | MEALS | LODGING | REPAIRS | OFFICE | OTHER
  category String

  /// Minor units (paise). ₹1,234.55 is stored as 123455.
  amountMinor Int
  currency    String @default("INR")

  /// The day the money was spent — normalised to UTC midnight like every other
  /// calendar day in this schema.
  expenseDate DateTime

  /// Who was paid, and the bill/invoice number, so finance can match it.
  vendor      String?
  referenceNo String?

  status      String    @default("DRAFT")
  submittedAt DateTime?

  decidedById  String?
  decidedBy    User?     @relation("ExpenseDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?

  /// Set when finance has actually paid it out.
  reimbursedAt DateTime?

  attachments Attachment[]
  comments    ExpenseComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([expenseDate])
  @@index([userId, status])
  @@index([category])
}

/// Conversation on a claim.
///
/// The decision note records the verdict; this records the back-and-forth that
/// reaches it ("which vehicle was this for?"). Keeping them separate means the
/// audit answer to "why was this approved" stays a single field rather than
/// something you reconstruct from a thread.
model ExpenseComment {
  id      String       @id @default(cuid())
  claimId String
  claim   ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  body String

  createdAt DateTime @default(now())

  @@index([claimId, createdAt])
}

// ---------------------------------------------------------------------------
//  Tasks
// ---------------------------------------------------------------------------

/// A unit of assigned work.
///
/// ## Why this is not just a report with a due date
///
/// A status report records what happened; a task is a commitment about what will.
/// That difference drives the shape here: a task has assignees (plural), a deadline
/// the system can chase, a progress figure, and a status it moves through — none of
/// which a report needs.
///
/// ## Deadlines are two fields, deliberately
///
/// `dueOn` is a calendar day at UTC midnight, like every other date in this schema,
/// and is what the calendar and "days remaining" work from. `deadlineAt` is an
/// optional exact instant for the cases where the hour matters ("before the 2pm
/// changeover"). Reminders fire off whichever is present, preferring the instant.
model Task {
  id String @id @default(cuid())

  /// Human reference shown to people and quoted in emails, e.g. "TSK-0042".
  taskNumber String @unique

  title String
  /// Markdown. Rendered by the same parser as reports and announcements, which
  /// builds React nodes rather than HTML — so a description cannot inject markup.
  description String

  /// LOW | MEDIUM | HIGH | CRITICAL
  priority String @default("MEDIUM")
  /// TODO | IN_PROGRESS | REVIEW | COMPLETED | BLOCKED
  status   String @default("TODO")

  categoryId String?
  category   TaskCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// Calendar day, UTC midnight.
  dueOn      DateTime?
  /// Optional exact instant, when the hour matters.
  deadlineAt DateTime?

  /// Estimated effort in minutes. Minutes rather than hours so half-hours need no
  /// float — the same reasoning as money in paise.
  estimateMinutes Int?

  /// 0-100. Set explicitly, or derived from the checklist when one exists.
  progressPercent Int @default(0)

  createdById String
  createdBy   User   @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)

  startedAt   DateTime?
  completedAt DateTime?
  /// Set when a completed task is reopened, so "was this ever finished?" survives.
  reopenedAt  DateTime?

  /// Why it is blocked, shown wherever the BLOCKED status is.
  blockedReason String?

  // --- Recurrence ---------------------------------------------------------
  /// NONE | DAILY | WEEKLY | MONTHLY. A recurring task is a *template*: the cron
  /// spawns a fresh copy each period rather than mutating one row, so every
  /// occurrence keeps its own updates, timeline and completion record.
  recurrence         String    @default("NONE")
  /// Every N days/weeks/months.
  recurrenceEvery    Int       @default(1)
  recurrenceUntil    DateTime?
  /// Set on spawned copies, pointing at the template they came from.
  recurrenceParentId String?
  recurrenceParent   Task?     @relation("TaskRecurrence", fields: [recurrenceParentId], references: [id], onDelete: SetNull)
  recurrenceChildren Task[]    @relation("TaskRecurrence")
  /// Last period the cron spawned, which is what makes re-running it idempotent.
  lastSpawnedFor     DateTime?

  // --- Reminder bookkeeping ----------------------------------------------
  /// Stamped when the 24-hour reminder and the overdue notice have gone out. This
  /// is what keeps the cron safe to run repeatedly.
  dueSoonRemindedAt DateTime?
  overdueNotifiedAt DateTime?

  assignees      TaskAssignee[]
  updates        TaskUpdate[]
  activities     TaskActivity[]
  attachments    Attachment[]
  tagLinks       TaskTagLink[]
  checklistItems TaskChecklistItem[]

  /// Tasks this one waits on.
  dependsOn TaskDependency[] @relation("TaskDependent")
  /// Tasks waiting on this one.
  blocks    TaskDependency[] @relation("TaskBlocker")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([dueOn])
  @@index([createdById])
  @@index([categoryId])
  @@index([status, dueOn])
  @@index([recurrence])
}

/// Grouping for tasks — a project, a line, or a workstream.
model TaskCategory {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  /// Token name from the chart palette, e.g. "indigo".
  color       String  @default("indigo")
  archived    Boolean @default(false)

  tasks Task[]

  createdAt DateTime @default(now())

  @@index([archived])
}

/// Join row for assignment.
///
/// A table rather than an implicit many-to-many, because assignment carries facts of
/// its own: who assigned it and when. "Reassigned by the works manager on Tuesday"
/// is exactly the kind of thing an audit trail gets asked for later.
model TaskAssignee {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("TaskAssignee", fields: [userId], references: [id], onDelete: Cascade)

  assignedById String?
  assignedBy   User?   @relation("TaskAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  assignedAt DateTime  @default(now())
  /// Per-assignee acknowledgement, so "has anyone actually read this?" is answerable.
  seenAt     DateTime?

  @@unique([taskId, userId])
  @@index([userId])
  @@index([taskId])
}

/// A posted update on a task — the threaded conversation.
///
/// Updates are additive and never overwrite one another, which is the whole point:
/// a third update saying "still blocked on the bearing lot" is only meaningful
/// beside the first two.
model TaskUpdate {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("TaskUpdateAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  /// Markdown, same renderer as the description.
  body String

  /// Threading: a reply points at the update it answers. One level is enough for a
  /// 20-person shop — deeper nesting reads worse than it helps.
  parentId String?
  parent   TaskUpdate?  @relation("TaskUpdateThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  TaskUpdate[] @relation("TaskUpdateThread")

  /// Progress reported alongside this update, if any. Kept on the update as well as
  /// on the task, so the history of "it was 40% here" survives later changes.
  progressPercent Int?

  attachments    Attachment[]
  tagLinks       TaskTagLink[]
  mentions       TaskMention[]
  /// Checklist items introduced by this update.
  checklistItems TaskChecklistItem[]

  editedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([taskId, createdAt])
  @@index([authorId])
  @@index([parentId])
}

/// An @mention of a person in an update.
///
/// Stored rather than re-parsed on read: it makes "everything I was mentioned in" an
/// indexed query instead of a full scan, and it pins the mention to the person who
/// was meant even if they later change their display name.
model TaskMention {
  id       String     @id @default(cuid())
  updateId String
  update   TaskUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("TaskMentioned", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([updateId, userId])
  @@index([userId])
}

/// One entry in a task timeline.
///
/// Distinct from `AuditLog`, which is an org-wide security record an admin reads.
/// This is the story of a single task, shown to everyone working on it — so it holds
/// human-readable before/after detail that the audit log has no business carrying.
model TaskActivity {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  actorId String?
  actor   User?   @relation("TaskActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  /// See TASK_ACTIVITY_KINDS in enums.ts — created, assigned, status_changed, …
  kind String

  /// JSON detail: the from/to of a status change, the filename added, and so on.
  meta String?
  /// Optional note the actor attached to the action itself.
  comment String?

  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
  @@index([kind])
}

/// Tag vocabulary, shared across the workspace so filters stay consistent.
model TaskTag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  /// Token name from the chart palette (see CHART_SERIES).
  color String @default("indigo")

  links TaskTagLink[]

  createdAt DateTime @default(now())
}

/// Tags apply to a task *or* to a single update — section 6 of the brief asks for
/// both, and one join table with two nullable parents keeps the tag vocabulary
/// single rather than splitting it in two.
model TaskTagLink {
  id    String  @id @default(cuid())
  tagId String
  tag   TaskTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  updateId String?
  update   TaskUpdate? @relation(fields: [updateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tagId, taskId])
  @@unique([tagId, updateId])
  @@index([taskId])
  @@index([updateId])
}

/// A tickable item on a task.
///
/// Lives on the task rather than inside the update that created it, so it stays
/// tickable afterwards — a checklist buried in update #2 that nobody can complete
/// from update #7 would be decoration.
model TaskChecklistItem {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  label String
  done  Boolean @default(false)

  doneAt   DateTime?
  doneById String?
  doneBy   User?     @relation("ChecklistCompleter", fields: [doneById], references: [id], onDelete: SetNull)

  /// Manual ordering within the list.
  position Int @default(0)

  /// The update that introduced it, where one did.
  createdInUpdateId String?
  createdInUpdate   TaskUpdate? @relation(fields: [createdInUpdateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([taskId, position])
}

/// "This task cannot start until that one is done."
model TaskDependency {
  id String @id @default(cuid())

  /// The task that must finish first.
  blockerId String
  blocker   Task   @relation("TaskBlocker", fields: [blockerId], references: [id], onDelete: Cascade)

  /// The task that waits.
  dependentId String
  dependent   Task   @relation("TaskDependent", fields: [dependentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerId, dependentId])
  @@index([dependentId])
}
